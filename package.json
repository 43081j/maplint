{
  "name": "maplint",
  "version": "0.0.0-dev",
  "description": "A tiny linter for validating source maps.",
  "type": "module",
  "bin": {
    "maplint": "./lib/cli.mjs"
  },
  "exports": {
    ".": "./lib/index.mjs",
    "./cli.js": "./lib/cli.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/**/*.test.js",
    "!lib/**/*.test.d.ts"
  ],
  "scripts": {
    "build": "tsdown",
    "lint:js": "oxlint src",
    "lint:format": "oxfmt --check src README.md",
    "lint": "npm run lint:js && npm run lint:format",
    "format": "oxfmt --write src README.md",
    "test": "npm run build && vitest run"
  },
  "keywords": [
    "sourcemaps",
    "sourcemap",
    "lint",
    "validation"
  ],
  "author": "James Garbutt (https://github.com/43081j)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/43081j/maplint#readme",
  "bugs": {
    "url": "https://github.com/43081j/maplint/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/43081j/maplint.git"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "publint": "^0.3.24",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "valibot": "^1.4.2",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@jridgewell/sourcemap-codec": "^1.5.5",
    "modern-tar": "^0.8.0"
  }
}
